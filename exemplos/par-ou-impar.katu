
mba'e n iaraba papasabamo(terenhe'eng("Digite um número para saber se é par ou ímpar: "));

emonãneme (n anheté 0) 
ypyrunga
    kuatiasába("Zero é par");
sykaba 
marandé (n % 2 anheté 0) 
ypyrunga
    kuatiasába(nhe'enga rupi(n) + " é par");
sykaba 
aane'yme 
ypyrunga
    kuatiasába(nhe'enga rupi(n) + " é ímpar");
sykaba