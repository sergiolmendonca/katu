
mba'e n îar papasabanamo(enhe'eng("Digite um número para saber se é par ou ímpar: "));

emonãneme (n îakatutenhẽ 0) 
ypy
    kûatiar("Zero é par");
sykaba 
na emonãneme ruã a'e (n % 2 îakatutenhẽ 0) 
ypy
    kûatiar(nhe'enganamo(n) + " é par");
sykaba 
na emonãneme ruã 
ypy
    kûatiar(nhe'enganamo(n) + " é ímpar");
sykaba