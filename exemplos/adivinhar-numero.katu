
mba'e n îar katu'ok(1, 10);
mba'e continua îar eté;
mba'e contador îar 0;

pukuî (continua)
ypy
    contador îar contador + 1;
    mba'e chute îar papasabanamo(enhe'eng("Chute um número de 1 a 10: "));
    emonãneme(chute îakatutenhẽ n)
    ypy
        kûatiar("Parabéns, você acertou em " + nhe'enganamo(contador) + " tentativa(s)! o número era " + nhe'enganamo(n));
        continua îar enhe'eng("deseja jogar novamente? [S/N]: ") îakatutenhẽ "S";
        emonãneme(continua)
        ypy
            n îar katu'ok(1, 10);
            contador îar 0;
        sykaba
    sykaba
    na emonãneme ruã
    ypy

        emonãneme(n turusu-eté chute)
        ypy
            kûatiar("Número errado. É um pouco maior");
        sykaba
        na emonãneme ruã
        ypy
            kûatiar("Número errado. É um pouco menor");
        sykaba
    sykaba
sykaba

kûatiar("Fim de jogo");