
mba'e n iaraba katu'okaba(1, 10);
mba'e continua iaraba seté;
mba'e contador iaraba 0;

#EXEMPLO DE COMENTÁRIO
remebé (continua)
ypyrunga
    contador iaraba contador + 1;
    mba'e chute iaraba papasabamo(terenhe'eng("Chute um número de 1 a 10: "));
    emonãneme(chute anheté n)
    ypyrunga
        kuatiasába("Parabéns, você acertou em " + nhe'enga rupi(contador) + " tentativa(s)! o número era " + nhe'enga rupi(n));
        continua iaraba terenhe'eng("deseja jogar novamente? [S/N]: ") anheté "S";
        emonãneme(continua)
        ypyrunga
            n iaraba katu'okaba(1, 10);
            contador iaraba 0;
        sykaba
    sykaba
    aane'yme
    ypyrunga
        emonãneme(n turusueté sosé chute)
        ypyrunga
            kuatiasába("Número errado. É um pouco maior");
        sykaba
        aane'yme
        ypyrunga
            kuatiasába("Número errado. É um pouco menor");
        sykaba
    sykaba
sykaba

kuatiasába("Fim de jogo");