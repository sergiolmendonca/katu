
mba'e continua iaraba seté;

remebé (continua)
ypyrunga
    kuatiasába("digite um número de 1 a 10 para saber a tabuada: ");
    mba'e n iaraba papasabamo(terenhe'eng());

    emonãneme (n ta'yrĩeté sosé 1 koipó n turusueté sosé 10)
    ypyrunga
        kuatiasába("Número inválido");
    sykaba
    aane'yme
    ypyrunga
        continua iaraba na setéi;
        mba'e i iaraba 1;
        remebé (i ta'yrĩeté sosé 11)
        ypyrunga
            kuatiasába(nhe'enga rupi(n) + " x " + nhe'enga rupi(i) + " = " + nhe'enga rupi(n*i));
            i iaraba i + 1;
        sykaba
    sykaba
sykaba
