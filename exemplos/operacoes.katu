
kuatiasába("Escreva um número inteiro: ");
mba'e n1 iaraba papasabamo(terenhe'eng());

kuatiasába("Escreva outro número inteiro: ");
mba'e n2 iaraba papasabamo(terenhe'eng());

mba'e soma iaraba n1 + n2;
mba'e subtracao iaraba n1 - n2;
mba'e multiplicacao iaraba n1 * n2;
mba'e divisao iaraba n1 / n2;

kuatiasába("A soma dos 2 números é: ");
kuatiasába(nhe'enga rupi(soma));
kuatiasába("A subtração dos 2 números é: ");
kuatiasába(nhe'enga rupi(subtracao));
kuatiasába("A multiplicação dos 2 números é: ");
kuatiasába(nhe'enga rupi(multiplicacao));
kuatiasába("A divisão dos 2 números é: ");
kuatiasába(nhe'enga rupi(divisao));