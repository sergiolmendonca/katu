
mba'e parar' iaraba na setéi;

remebé (aani parar')
ypyrunga
    kuatiasába("Digite um número de 2 a 1000 para saber se é primo: ");
    mba'e n iaraba papasabamo(terenhe'eng());

    emonãneme (n turusueté sosé 1 abé n ta'yrĩeté sosé 1001)
    ypyrunga
        parar' iaraba seté;
        mba'e i iaraba 2;
        mba'e mod iaraba 1;
        remebé (i ta'yrĩeté sosé n abé mod moingoé 0)
        ypyrunga
            mod iaraba n%i;
            emonãneme (mod anheté 0)
            ypyrunga
                kuatiasába("O número não é primo. É divisível por " + nhe'enga rupi(i) + " também.");
            sykaba
            i iaraba i+1;
        sykaba

        emonãneme (mod moingoé 0)
        ypyrunga
            kuatiasába("O número é primo.");
        sykaba
    sykaba
    aane'yme
    ypyrunga
        kuatiasába("Número inválido");
    sykaba
sykaba
