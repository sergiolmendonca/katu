
mba'e n îar 1;

pukuî (n a'yrĩ-eté 10)
ypy
    emonãneme (n îakatutenhẽ 0) 
    ypy
        kûatiar(nhe'enga(n) + " é Zero");
    sykaba 
    na emonãneme ruã a'e (n % 2 îakatutenhẽ 0) 
    ypy
        kûatiar(nhe'enga(n) + " é Par");
    sykaba 
    na emonãneme ruã 
    ypy
        kûatiar(nhe'enga(n) + " é Ímpar");
    sykaba

    n îar n + 1;
sykaba

kûatiar("fim");